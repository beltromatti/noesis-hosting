generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  PENDING
  ACTIVE
  FAILED
  DISABLED
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DomainType {
  FREE_SUBDOMAIN
  CUSTOM
  PURCHASE_REQUEST
}

enum DeploymentStatus {
  PENDING
  DEPLOYING
  ACTIVE
  FAILED
  ROLLED_BACK
}

enum DomainPurchaseStatus {
  PENDING
  IN_REVIEW
  SUBMITTED
  COMPLETED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

enum SiteRuntime {
  STATIC
  SPA
  PHP
}

enum SecurityScanStatus {
  UNKNOWN
  PASS
  WARN
  FAIL
}

enum UsageEventType {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGIN_FAILED
  SITE_CREATED
  SITE_DEPLOYED
  SITE_DEPLOYMENT_FAILED
  SITE_PAUSED
  SITE_RESUMED
  SITE_DELETED
  DOMAIN_UPDATED
  SECURITY_UPDATED
  DOMAIN_REQUESTED
  DOMAIN_VERIFICATION_FAILED
}

enum AuthEventType {
  SIGNUP
  LOGIN_SUCCESS
  LOGIN_FAILURE
  SESSION_CREATED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String?
  role         UserRole   @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sites        Site[]
  sessions     Session[]
  usageEvents  UsageEvent[]
  analytics    UserAnalytics?
  accessLogs   UserAccessLog[]
}

model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  accessLogs UserAccessLog[]
}

model Site {
  id               String        @id @default(cuid())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  name             String
  slug             String        @unique
  status           SiteStatus    @default(PENDING)
  runtime          SiteRuntime   @default(STATIC)
  storagePath      String
  maxUploadSize    Int           @default(157286400)
  lastDeploymentAt DateTime?
  securityConfig   Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  domains          SiteDomain[]
  deployments      Deployment[]
  purchaseRequests DomainPurchaseRequest[]
  usageEvents      UsageEvent[]
  analytics        SiteAnalytics?
  securityProfile  SiteSecurityProfile?
}

model SiteDomain {
  id                  String       @id @default(cuid())
  site                Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId              String
  hostname            String       @unique
  isPrimary           Boolean      @default(false)
  verificationStatus  DomainStatus @default(PENDING)
  type                DomainType   @default(FREE_SUBDOMAIN)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Deployment {
  id           String            @id @default(cuid())
  site         Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId       String
  status       DeploymentStatus  @default(PENDING)
  notes        String?
  createdAt    DateTime          @default(now())
  completedAt  DateTime?
}

model DomainPurchaseRequest {
  id        String                @id @default(cuid())
  site      Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId    String
  domain    String
  tlds      String[]
  status    DomainPurchaseStatus  @default(PENDING)
  budgetUsd Int?
  notes     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([siteId, status])
}

model UserAnalytics {
  id                  String   @id @default(cuid())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String   @unique
  totalSites          Int      @default(0)
  activeSites         Int      @default(0)
  pausedSites         Int      @default(0)
  totalDeployments    Int      @default(0)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int      @default(0)
  abuseReports        Int      @default(0)
  riskScore           Int      @default(0)
  riskReasons         String[]
  totalLogins         Int      @default(0)
  totalLoginFailures  Int      @default(0)
  distinctIpCount     Int      @default(0)
  distinctUserAgentCount Int   @default(0)
  lastLoginUserAgent  String?
  lastLoginCity       String?
  lastLoginCountry    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([riskScore, updatedAt])
}

model SiteAnalytics {
  id                       String     @id @default(cuid())
  site                     Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId                   String     @unique
  totalDeployments         Int        @default(0)
  successfulDeployments    Int        @default(0)
  failedDeployments        Int        @default(0)
  totalUploads             Int        @default(0)
  totalBytesUploaded       BigInt     @default(0)
  lastDeploymentAt         DateTime?
  lastDeploymentSizeBytes  BigInt?
  lastMalwareScanAt        DateTime?
  lastMalwareScanPassed    Boolean?
  dnsVerified              Boolean    @default(false)
  proxiedThroughCloudflare Boolean    @default(false)
  pausedAt                 DateTime?
  lastStatus               SiteStatus?
  runtime                  SiteRuntime?
  riskScore                Int        @default(0)
  riskReasons              String[]
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([riskScore, updatedAt])
  @@index([dnsVerified, updatedAt])
}

model SiteSecurityProfile {
  id                String              @id @default(cuid())
  site              Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId            String              @unique
  runtime           SiteRuntime         @default(STATIC)
  isolated          Boolean             @default(true)
  cpuLimitPercent   Int                 @default(20)
  memoryLimitMb     Int                 @default(256)
  storageLimitMb    Int                 @default(200)
  processLimit      Int                 @default(8)
  lastScanAt        DateTime?
  lastScanStatus    SecurityScanStatus  @default(UNKNOWN)
  lastScanNotes     String?
  phpOpenBaseDir    String?
  phpDisabledFuncs  String[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model UsageEvent {
  id        String         @id @default(cuid())
  eventType UsageEventType
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  site      Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId    String?
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([siteId, createdAt])
}

model IpAddressInsight {
  ipAddress   String           @id
  city        String?
  region      String?
  country     String?
  latitude    Float?
  longitude   Float?
  timezone    String?
  postal      String?
  org         String?
  asn         String?
  asnName     String?
  asnDomain   String?
  asnType     String?
  carrierName String?
  carrierMcc  String?
  carrierMnc  String?
  host        String?
  threatLevel String?
  proxyType   String?
  isBogon     Boolean          @default(false)
  raw         Json?
  fetchedAt   DateTime         @default(now())
  expiresAt   DateTime?
  accessLogs  UserAccessLog[]
}

model UserAccessLog {
  id                    String            @id @default(cuid())
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                String?
  session               Session?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  sessionId             String?
  email                 String?
  eventType             AuthEventType
  occurredAt            DateTime          @default(now())
  ipAddress             String?
  ipInsight             IpAddressInsight? @relation(fields: [ipAddress], references: [ipAddress], onDelete: SetNull)
  userAgent             String?
  clientBrowser         String?
  clientBrowserVersion  String?
  clientOs              String?
  clientOsVersion       String?
  clientDevice          String?
  clientPlatform        String?
  clientEngine          String?
  isMobile              Boolean?
  isBot                 Boolean?
  geoCity               String?
  geoRegion             String?
  geoCountry            String?
  geoTimezone           String?
  geoLoc                String?
  isp                   String?
  org                   String?
  confidence            Float?
  metadata              Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([userId, occurredAt])
  @@index([email, occurredAt])
  @@index([ipAddress, occurredAt])
  @@index([eventType, occurredAt])
}
